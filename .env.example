# ---------------------------------------------------------------------------
# Palpito - configuracion
#
# Copia este archivo como .env y pon tus valores reales.
# El archivo .env NUNCA se sube a git (esta en .gitignore).
# ---------------------------------------------------------------------------

# Clave de OpenRouter. Se consigue en https://openrouter.ai/keys
# Si la dejas vacia, la aplicacion funciona igual: calcula todos los
# indicadores y las alertas, y solo se desactiva la redaccion en prosa.
OPENROUTER_API_KEY=

# Modelo a usar. Alternativas probadas:
#   deepseek/deepseek-v4-flash  -> muy economico, suficiente para redactar
#   deepseek/deepseek-v4-pro    -> mas caro, mejor prosa
OPENROUTER_MODELO=deepseek/deepseek-v4-flash
